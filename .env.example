# Supabase Configuration (PUBLIC - safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_BUCKET=media

# Database Configuration (SENSITIVE - use Vercel environment variables)
POSTGRES_URL=postgresql://user:password@host:port/database
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:port/database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=db.your-project.supabase.co
POSTGRES_DATABASE=postgres
POSTGRES_PRISMA_URL=postgresql://user:password@pooler.supabase.com:6543/database

# Supabase Service Credentials (SENSITIVE - server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your_jwt_secret_here
SUPABASE_SECRET_KEY=sb_secret_...

# Public Supabase Keys (SAFE - prefixed with NEXT_PUBLIC_ or VITE_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: PDF API URL
VITE_PDF_API_URL=https://your-pdf-api.fly.dev

# IMPORTANT SECURITY NOTES:
# 1. Never commit .env files to git
# 2. Use VITE_ prefix for variables accessed in the browser (public)
# 3. Use NEXT_PUBLIC_ prefix only for safe, public values in Next.js
# 4. For Vercel: Set sensitive variables in Vercel Dashboard → Settings → Environment Variables
# 5. Create separate .env files for development, staging, and production
# 6. Rotate credentials regularly, especially after any security incident
# 7. Use different service role keys for different environments
